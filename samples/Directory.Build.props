<Project>

    <!--
        This tree is not under src/, so MSBuild does not read src/Directory.Build.props here. MSBuild
        takes the nearest file above a project and stops, thus nothing under samples/ reaches the file
        under src/. This file repeats the rules that every project must keep, and nothing else.

        That is deliberate. The samples are not part of the build under src/: each sample has its own
        solution, and each project references the published packages of this repository, not the
        projects under src/. The samples are not packages, so they carry no MinVer and no package
        metadata.
    -->

    <!-- No default items. Every project lists each Compile, AvaloniaXaml, and None item by name. -->
    <PropertyGroup>
        <EnableDefaultItems>false</EnableDefaultItems>
    </PropertyGroup>

    <!-- Every project restores through a committed packages.lock.json. Locked mode is on CI only. -->
    <PropertyGroup>
        <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
        <RestoreLockedMode Condition="'$(CI)' != ''">true</RestoreLockedMode>
    </PropertyGroup>

    <!--
        The analyzers of MorseCode.Analyzers, as the package that users install. src/Directory.Build.props
        refers to the project, because the toolkit builds with the analyzer it is changing. A sample
        uses the published version, at a pinned version, as it does for every other package. The
        package is a development dependency, thus NuGet adds it with PrivateAssets="all".
    -->
    <ItemGroup>
        <PackageReference Include="MorseCode.Analyzers" Version="0.1.1" PrivateAssets="all"/>
    </ItemGroup>

</Project>
