<Project Sdk="Microsoft.NET.Sdk">

    <!--
        Avalonia 12 ships for net8.0 and net10.0 only, so this package cannot take the net472,
        net6.0, and netstandard2.0 targets of the other packages here. It follows Avalonia instead.
    -->
    <PropertyGroup>
        <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
        <LangVersion>14</LangVersion>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <PropertyGroup Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">
        <IsAotCompatible>true</IsAotCompatible>
    </PropertyGroup>

    <PropertyGroup>
        <PackageId>MorseCode.Controls.UI.Avalonia</PackageId>
        <MinVerTagPrefix>morsecode-controls-ui-avalonia-</MinVerTagPrefix>
        <Product>MorseCode.Controls.UI.Avalonia</Product>
        <Title>MorseCode.Controls.UI.Avalonia</Title>
        <Description>Avalonia controls and converters for views that bind to view models written in a functional reactive style on SodaFlow.</Description>
        <PackageIcon>MorseCode.png</PackageIcon>
        <AssemblyName>MorseCode.Controls.UI.Avalonia</AssemblyName>
        <RootNamespace>MorseCode.Controls.UI.Avalonia</RootNamespace>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <!--
        12.1.3 is the version that the behavior of the ComboBox here was checked against: the
        deferral of BeginInit and EndInit in SelectingItemsControl, and what Avalonia's ComboBox writes back
        when its list changes.
    -->
    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.1.3"/>
    </ItemGroup>

    <!--
        MaybeConverter converts the Maybe of SodaFlow view models. The control reads and writes the
        bindable values of SodaFlow.
    -->
    <ItemGroup>
        <PackageReference Include="SodaFlow.Bindable.ObjectModel" Version="4.0.0"/>
        <PackageReference Include="SodaFlow.Functional" Version="3.0.2"/>
    </ItemGroup>

    <!--
        The source that the control binds to, and the values that go between the two. They are in a
        package with no UI framework, so that a view model does not reference this one.
    -->
    <ItemGroup>
        <ProjectReference Include="..\MorseCode.Controls.ViewModels\MorseCode.Controls.ViewModels.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <Compile Include="ComboBox.cs"/>
        <Compile Include="ItemChange.cs"/>
        <Compile Include="MaybeConversion.cs"/>
        <Compile Include="MaybeConverter.cs"/>
        <Compile Include="MaybeConverter.Generic.cs"/>
        <Compile Include="RowPlaceholder.cs"/>
        <Compile Include="VirtualizingItemsControl.cs"/>
        <Compile Include="VirtualItemList.cs"/>
    </ItemGroup>

    <!-- VirtualItemList is internal, and its tests check the events that it raises. -->
    <ItemGroup>
        <InternalsVisibleTo Include="MorseCode.Controls.UI.Avalonia.Tests"/>
    </ItemGroup>

    <ItemGroup>
        <None Include="..\..\logo\MorseCode.png" Pack="true" PackagePath="\">
            <Link>MorseCode.png</Link>
        </None>
    </ItemGroup>

</Project>
