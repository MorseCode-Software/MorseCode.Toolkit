<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net10.0;net472</TargetFrameworks>
        <OutputType>Exe</OutputType>
        <LangVersion>14</LangVersion>
        <Nullable>enable</Nullable>
        <!-- The usings are listed per file here, as everywhere else in this repository. -->
        <TUnitImplicitUsings>disable</TUnitImplicitUsings>
        <TUnitAssertionsImplicitUsings>disable</TUnitAssertionsImplicitUsings>
        <!-- TUnit's transitive dependencies do not claim net472; their netstandard2.0 assets work. -->
        <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
    </PropertyGroup>

    <!-- Microsoft.Testing.Platform builds a native apphost for net472, which needs an explicit RID. -->
    <PropertyGroup Condition=" '$(TargetFramework)' == 'net472' ">
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    </PropertyGroup>

    <PropertyGroup>
        <AssemblyName>MorseCode.Mvvm.Tests</AssemblyName>
        <RootNamespace>MorseCode.Mvvm.Tests</RootNamespace>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="TUnit" Version="1.66.27"/>
    </ItemGroup>

    <ItemGroup>
        <Compile Include="..\TestPolyfills.cs" Link="TestPolyfills.cs"/>
    </ItemGroup>

    <ItemGroup>
        <Compile Include="ActionDisposableTests.cs"/>
        <Compile Include="CompositeDisposableTests.cs"/>
        <Compile Include="ViewModelBaseBindableFactoryTests.cs"/>
        <Compile Include="ViewModelBaseConcurrencyTests.cs"/>
        <Compile Include="ViewModelBaseTests.cs"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\MorseCode.Mvvm\MorseCode.Mvvm.csproj"/>
    </ItemGroup>

</Project>
