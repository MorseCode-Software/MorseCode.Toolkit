<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="clr-namespace:MorseCode.Avalonia.Controls;assembly=MorseCode.Avalonia.Controls"
             xmlns:tests="clr-namespace:MorseCode.Avalonia.Controls.Tests"
             x:Class="MorseCode.Avalonia.Controls.Tests.MaybeComboBoxView"
             x:CompileBindings="True"
             x:DataType="tests:MaybeSelectionModel">

    <mc:ComboBox x:Name="Box"
                 ItemsSource="{Binding Items}"
                 SelectedItem="{Binding Selected, Mode=TwoWay, Converter={x:Static mc:MaybeConverter.Instance}}" />

</UserControl>
