<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MorseCode.Avalonia.Controls;assembly=MorseCode.Avalonia.Controls"
             xmlns:tests="clr-namespace:MorseCode.Avalonia.Controls.Tests"
             x:Class="MorseCode.Avalonia.Controls.Tests.ComboBoxView"
             x:CompileBindings="True"
             x:DataType="tests:SelectionModel">

    <controls:ComboBox x:Name="Box"
                       ItemsSource="{Binding Items}"
                       SelectedItem="{Binding Selected, Mode=TwoWay}" />

</UserControl>
