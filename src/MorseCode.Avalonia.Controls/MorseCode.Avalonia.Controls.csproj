<Project Sdk="Microsoft.NET.Sdk">

    <!--
        Avalonia 12 ships for net8.0 and net10.0 only, so this package cannot take the net472,
        net6.0, and netstandard2.0 targets of the other packages here. It follows Avalonia instead.
    -->
    <PropertyGroup>
        <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
        <LangVersion>14</LangVersion>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <PropertyGroup>
        <PackageId>MorseCode.Avalonia.Controls</PackageId>
        <MinVerTagPrefix>morsecode-avalonia-controls-</MinVerTagPrefix>
        <Product>MorseCode.Avalonia.Controls</Product>
        <Title>MorseCode.Avalonia.Controls</Title>
        <Description>Avalonia controls and converters for views that bind to view models written in a functional reactive style on SodaFlow.</Description>
        <PackageIcon>MorseCode.png</PackageIcon>
        <AssemblyName>MorseCode.Avalonia.Controls</AssemblyName>
        <RootNamespace>MorseCode.Avalonia.Controls</RootNamespace>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <!--
        12.1.3 is the version that the behavior of the ComboBox here was checked against: the
        deferral of BeginInit and EndInit in SelectingItemsControl, and what Avalonia's ComboBox writes back
        when its list changes.
    -->
    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.1.3"/>
    </ItemGroup>

    <!--
        MaybeConverter converts the Maybe of SodaFlow view models. The control reads and writes the
        bindable values of SodaFlow, and the builders of its source use the cells, the streams, and
        the collections.
    -->
    <ItemGroup>
        <PackageReference Include="SodaFlow" Version="5.0.1"/>
        <PackageReference Include="SodaFlow.Bindable.ObjectModel" Version="4.0.0"/>
        <PackageReference Include="SodaFlow.Collections" Version="2.0.0"/>
        <PackageReference Include="SodaFlow.Functional" Version="3.0.2"/>
    </ItemGroup>

    <!-- CreateVirtualItemsSource registers the disposal of its source with the IOutput of a view model. -->
    <ItemGroup>
        <ProjectReference Include="..\MorseCode.Mvvm\MorseCode.Mvvm.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <Compile Include="ComboBox.cs"/>
        <Compile Include="IVirtualItemsSource.cs"/>
        <Compile Include="ItemRange.cs"/>
        <Compile Include="MaybeConversion.cs"/>
        <Compile Include="MaybeConverter.cs"/>
        <Compile Include="MaybeConverter.Generic.cs"/>
        <Compile Include="RowPlaceholder.cs"/>
        <Compile Include="ScrollRequestBindables.cs"/>
        <Compile Include="ScrollRequestExtensions.cs"/>
        <Compile Include="VirtualizingItemsControl.cs"/>
        <Compile Include="VirtualRows.cs"/>
        <Compile Include="VirtualItemList.cs"/>
        <Compile Include="VirtualItemsSource.cs"/>
        <Compile Include="VirtualItemsSourceExtensions.cs"/>
    </ItemGroup>

    <!-- VirtualItemList is internal, and its tests check the events that it raises. -->
    <ItemGroup>
        <InternalsVisibleTo Include="MorseCode.Avalonia.Controls.Tests"/>
    </ItemGroup>

    <ItemGroup>
        <None Include="..\..\logo\MorseCode.png" Pack="true" PackagePath="\">
            <Link>MorseCode.png</Link>
        </None>
    </ItemGroup>

</Project>
