<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net472;net6.0;net8.0;netstandard2.0</TargetFrameworks>
        <LangVersion>14</LangVersion>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <PropertyGroup Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">
        <IsAotCompatible>true</IsAotCompatible>
    </PropertyGroup>

    <PropertyGroup>
        <PackageId>MorseCode.StagedConstruction</PackageId>
        <MinVerTagPrefix>morsecode-stagedconstruction-</MinVerTagPrefix>
        <Product>MorseCode.StagedConstruction</Product>
        <Title>MorseCode.StagedConstruction</Title>
        <Description>Construction of immutable objects in ordered stages, with no access to a partly built object.</Description>
        <PackageIcon>MorseCode.png</PackageIcon>
        <AssemblyName>MorseCode.StagedConstruction</AssemblyName>
        <RootNamespace>MorseCode.StagedConstruction</RootNamespace>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="Constructed.cs"/>
        <Compile Include="Constructor.cs"/>
        <Compile Include="Constructor.Generic.cs"/>
        <Compile Include="SelectedConstruct.cs"/>
        <Compile Include="SingleUse.cs"/>
        <Compile Include="Stage.cs"/>
        <Compile Include="Stage.Generic.cs"/>
        <Compile Include="StageContinuation.cs"/>
        <Compile Include="StageFromBody.cs"/>
        <Compile Include="ValuesConstruct.cs"/>
    </ItemGroup>

    <!--
        The analyzer for continuations ships inside this package, under analyzers/dotnet/cs, where
        the compiler of a consumer loads it with no step of their own. NuGet gives the analyzers of a
        package to each project that has the package anywhere in its packages, thus a project that
        references MorseCode.Mvvm or MorseCode.Controls.UI.Avalonia gets it too. The dll comes from the
        build of the analyzer project, which the project reference in Directory.Build.props orders
        before this one. That reference is not a dependency of the package.
    -->
    <ItemGroup>
        <None Include="..\MorseCode.StagedConstruction.Analyzers\bin\$(Configuration)\netstandard2.0\MorseCode.StagedConstruction.Analyzers.dll"
              Pack="true"
              PackagePath="analyzers/dotnet/cs"
              Visible="false"/>
    </ItemGroup>

    <ItemGroup>
      <None Include="..\..\logo\MorseCode.png" Pack="true" PackagePath="\">
        <Link>MorseCode.png</Link>
      </None>
    </ItemGroup>

</Project>
