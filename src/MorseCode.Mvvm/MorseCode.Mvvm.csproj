<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net472;net6.0;netstandard2.0</TargetFrameworks>
        <LangVersion>14</LangVersion>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <PropertyGroup>
        <PackageId>MorseCode.Mvvm</PackageId>
        <MinVerTagPrefix>morsecode-mvvm-</MinVerTagPrefix>
        <Product>MorseCode.Mvvm</Product>
        <Title>MorseCode.Mvvm</Title>
        <Description>Building blocks for view models written in a functional reactive style on SodaFlow.</Description>
        <PackageIcon>MorseCode.png</PackageIcon>
        <AssemblyName>MorseCode.Mvvm</AssemblyName>
        <RootNamespace>MorseCode.Mvvm</RootNamespace>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="SodaFlow.Bindable.ObjectModel" Version="4.0.0"/>
    </ItemGroup>

    <ItemGroup>
        <Compile Include="ActionDisposable.cs"/>
        <Compile Include="CompositeDisposable.cs"/>
        <Compile Include="EmptyDisposable.cs"/>
        <Compile Include="IViewModel.cs"/>
        <Compile Include="ViewModelBase.cs"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\MorseCode.StagedConstruction\MorseCode.StagedConstruction.csproj"/>
    </ItemGroup>

    <ItemGroup>
      <None Include="..\..\logo\MorseCode.png" Pack="true" PackagePath="\">
        <Link>MorseCode.png</Link>
      </None>
    </ItemGroup>

</Project>
