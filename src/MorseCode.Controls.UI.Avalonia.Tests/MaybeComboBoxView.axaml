<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="clr-namespace:MorseCode.Controls.UI.Avalonia;assembly=MorseCode.Controls.UI.Avalonia"
             xmlns:tests="clr-namespace:MorseCode.Controls.UI.Avalonia.Tests"
             x:Class="MorseCode.Controls.UI.Avalonia.Tests.MaybeComboBoxView"
             x:CompileBindings="True"
             x:DataType="tests:MaybeSelectionModel">

    <mc:ComboBox x:Name="Box"
                 ItemsSource="{Binding Items}"
                 SelectedItem="{Binding Selected, Mode=TwoWay, Converter={x:Static tests:StringMaybeConverter.Instance}}" />

</UserControl>
