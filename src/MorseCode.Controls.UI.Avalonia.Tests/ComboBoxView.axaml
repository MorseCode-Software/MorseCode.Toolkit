<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MorseCode.Controls.UI.Avalonia;assembly=MorseCode.Controls.UI.Avalonia"
             xmlns:tests="clr-namespace:MorseCode.Controls.UI.Avalonia.Tests"
             x:Class="MorseCode.Controls.UI.Avalonia.Tests.ComboBoxView"
             x:CompileBindings="True"
             x:DataType="tests:SelectionModel">

    <controls:ComboBox x:Name="Box"
                       ItemsSource="{Binding Items}"
                       SelectedItem="{Binding Selected, Mode=TwoWay}" />

</UserControl>
